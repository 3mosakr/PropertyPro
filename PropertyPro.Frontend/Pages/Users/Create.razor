@page "/Users/Create"

<h3>Create User</h3>

<EditForm Model="this" OnValidSubmit="CreateUser">

	<div class="row">

		<div class="col-lg-8">
			<h1 class="mb-5">New User</h1>

			<div class="row mb-3">
				<label class="col-md-4 col-form-label">User Images</label>
				<div class="col-md-8">
					<InputFile OnChange="HandleFileSelected" accept="image/*" />
				</div>
			</div>

			<div class="row mb-3">
				<label class="col-md-4 col-form-label">First Name</label>
				<div class="col-md-8">
					<InputText @bind-Value="UserDto.FirstName" class="form-control" required />
				</div>
			</div>

			<div class="row mb-3">
				<label class="col-md-4 col-form-label">Last Name</label>
				<div class="col-md-8">
					<InputText @bind-Value="UserDto.LastName" class="form-control" required />
				</div>
			</div>

			<div class="row mb-3">
				<label class="col-md-4 col-form-label">Address</label>
				<div class="col-md-8">
					<InputText @bind-Value="UserDto.Address" class="form-control" required />
				</div>
			</div>

			<div class="row mb-3">
				<label class="col-md-4 col-form-label">Phone Number</label>
				<div class="col-md-8">
					<InputText @bind-Value="UserDto.PhoneNumber" class="form-control" required />
				</div>
			</div>

			<div class="row mb-3">
				<label class="col-md-4 col-form-label">Username</label>
				<div class="col-md-8">
					<InputText @bind-Value="UserDto.UserName" class="form-control" required />
				</div>
			</div>

			<div class="row mb-3">
				<label class="col-md-4 col-form-label">Email</label>
				<div class="col-md-8">
					<InputText @bind-Value="UserDto.Email" class="form-control" required />
				</div>
			</div>

			<div class="row mb-3">
				<label class="col-md-4 col-form-label">Password</label>
				<div class="col-md-8">
					<InputText @bind-Value="UserDto.Password" type="password" class="form-control" required />
					<small class="form-text text-muted mt-2">
						- Must contain an <strong>Uppercase letter</strong><br />
						- Must contain a <strong>Lowercase letter</strong><br />
						- Must contain a <strong>Number</strong><br />
						- Must contain a <strong>Special character</strong>
						- <strong>Minimum length is 6 characters</strong>
					</small>
				</div>
			</div>

			<div class="row mb-3">
				<label class="col-md-4 col-form-label">User Type</label>
				<div class="col-md-8">
					<InputSelect class="form-control" @bind-Value="UserDto.UserTypeId" required>
						<option selected hidden> -- select User Type -- </option>
						@foreach (var userType in userTypes)
						{
							<option value="@userType.Id">@userType.Type</option>
						}
					</InputSelect>
				</div>
			</div>

			<div class="row">
				<div class="offset-md-4 col-md-4 d-grid">
					<button class="btn btn-primary" type="submit">Create</button>
				</div>
				<div class="col-md-4 d-grid">
					<a class="btn btn-secondary" href="/Users">Back</a>
				</div>
			</div>

		</div>
	</div>
</EditForm>
@if (!string.IsNullOrEmpty(resultMessage))
{
	<div class="row">
		<div class="@resultMessageCssClass" role="alert">
			@resultMessage
		</div>
	</div>
}

@inject ITypesService TypesService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@inject IUserService UserService

@code {
	private string? token;
	private string? resultMessage;
	private string resultMessageCssClass = "";

	private AddUserDto UserDto = new AddUserDto();
	private List<UserType> userTypes = new List<UserType>();
	// =================
	private IBrowserFile? uploadedImage;
	private const int maxAllowedSize = 5 * 1024 * 1024;

	private void HandleFileSelected(InputFileChangeEventArgs e)
	{
		uploadedImage = e.File;
	}
	// =================

	protected override async Task OnInitializedAsync()
	{
		// Get the token from localStorage
		token = await GetTokenAsync();

		// If no token found, redirect to login
		if (string.IsNullOrEmpty(token))
		{
			Navigation.NavigateTo("/login");
			return;
		}

		// Fetch User Types with token
		await LoadUserTypesAsync();
	}

	private async Task<string> GetTokenAsync()
	{
		try
		{
			return await JSRuntime.InvokeAsync<string>("localStorage.getItem", "authToken");
		}
		catch (Exception ex)
		{
			Console.WriteLine($"Error getting token: {ex.Message}");
			return null;
		}
	}

	private async Task LoadUserTypesAsync()
	{
		try
		{

			var response = await TypesService.GetUserTypesListAsync();

			if (response?.Data != null)
			{
				userTypes = response.Data;
			}
			else
			{
				Console.WriteLine("Error: No data found in response.");
			}
		}
		catch (Exception ex)
		{
			Console.WriteLine($"Error loading User Types: {ex.Message}");
		}
	}


	protected async Task CreateUser()
	{
		try
		{
			var content = new MultipartFormDataContent();

			// Add text properties
			content.Add(new StringContent(UserDto.FirstName ?? ""), "FirstName");
			content.Add(new StringContent(UserDto.LastName ?? ""), "LastName");
			content.Add(new StringContent(UserDto.Address ?? ""), "Address");
			content.Add(new StringContent(UserDto.PhoneNumber ?? ""), "PhoneNumber");
			content.Add(new StringContent(UserDto.UserName ?? ""), "UserName");
			content.Add(new StringContent(UserDto.Email ?? ""), "Email");
			content.Add(new StringContent(UserDto.Password ?? ""), "Password");
			content.Add(new StringContent(UserDto.UserTypeId.ToString()), "UserTypeId");

			// Add optional image file
			if (uploadedImage != null)
			{
				var stream = uploadedImage.OpenReadStream(maxAllowedSize); // ممكن تحدد max حسب الحاجة
				var streamContent = new StreamContent(stream);
				streamContent.Headers.ContentType = new MediaTypeHeaderValue(uploadedImage.ContentType);
				content.Add(streamContent, "Photo", uploadedImage.Name); // اسم الخاصية في الـ DTO لازم يكون مطابق
			}


			var response = await UserService.CreateUserAsync(content);
			if (response != null && response.Status)
			{
				// resultMessage = response.Message;
				Console.WriteLine("User created successfully.");
				SetResultMessage(response.Message, true);
				Navigation.NavigateTo("/Users");
			}
			else
			{
				SetResultMessage($"Error while creating user: {response!.Message}", false);
				// resultMessage = $"Error while creating user: {response!.Message}";
				Console.WriteLine("Error creating user.");
			}
			
		}
		catch (Exception ex)
		{
			// resultMessage = $"Error creating user: {ex.Message}";
			SetResultMessage($"Error creating user: {ex.Message}", false);
			Console.WriteLine($"Error creating user: {ex.Message}");
		}
		// finally
		// {
		// 	await LoadUserTypesAsync();
		// }
	}
	
	private void SetResultMessage(string message, bool isSuccess)
	{
		resultMessage = message;
		resultMessageCssClass = isSuccess ? "alert alert-success" : "alert alert-danger";
	}

}
