@page "/Users"


<h3>Users</h3>
<a class="btn btn-primary" href="/Users/Create">Create New User</a>

@if (users == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Email</th>
                <th>Address</th>
                <th>UserType</th>
                
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in users)
            {
                <tr>
                    <td>@user.Id</td>
                    <td>@user.FullName</td>
                    <td>@user.Email</td>
                    <td>@user.Address</td>
                    <td>@user.UserType</td>
                    
                    <td>
                        @* <a class="btn btn-success btn-sm" href="/units/Update/@user.Id">Edit</a> *@
                        @* <a class="btn btn-danger btn-sm" href="/units/Delete/@user.Id">Delete</a> *@
                        @if (user.LockoutEnd == null || user.LockoutEnd < DateTime.Now)
                        {
                            <button class="btn btn-success" title="Lock user" @onclick="@(() => LockUnLock(user.Id))">
                                <i class="bi bi-unlock-fill"></i>
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-danger" title="Unlock user" @onclick="@(() => LockUnLock(user.Id))">
                                <i class="bi bi-lock-fill"></i>
                            </button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div>
        <button class="btn btn-lg btn-primary" @onclick="PrevPage" disabled="@(!hasPrev)">Previous</button>
        <span>
            Page <input type="number" min="1" max="@totalPages" @bind="CurrentPage" @bind:event="oninput" @onkeypress="HandleEnterKey" style="width: 50px;" /> of @totalPages
        </span>
        <button class="btn btn-lg btn-primary" @onclick="NextPage" disabled="@(!hasNext)">Next</button>
    </div>
}





@inject IUserService UserService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

@code {
    private List<UserDto> users = new();
    private int CurrentPage = 1;
    private int pageSize = 10;
    private bool hasNext;
    private bool hasPrev;
    private int totalPages;

    private string? token;

    protected override async Task OnInitializedAsync()
    {
        token = await GetTokenAsync();

        if (string.IsNullOrEmpty(token))
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadUsersAsync();
    }

    private async Task<string?> GetTokenAsync()
    {
        try
        {
            return await JSRuntime.InvokeAsync<string>("localStorage.getItem", "authToken");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error getting token: {ex.Message}");
            return null;
        }
    }

    private async Task LoadUsersAsync()
    {
        try
        {
            var response = await UserService.GetUsersListAsync(page: CurrentPage, pageSize: pageSize);

            if (response?.Data != null)
            {
                users = response.Data;
                hasNext = response.HasNextPage;
                hasPrev = response.HasPreviousPage;
                totalPages = response.TotalPages;
            }
            else
            {
                users = new List<UserDto>();
                Console.WriteLine("Error: No data found in response.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading units: {ex.Message}");
        }
    }

    private async Task LockUnLock(int userId)
	{
		try
		{
			// Implement the logic to lock/unlock the user
			// For example, you might call a service method here
			await UserService.LockUnlockUserAsync(userId);
            await LoadUsersAsync(); // Refresh the list after the operation
		}
		catch (Exception ex)
		{
			Console.WriteLine($"Error locking/unlocking user: {ex.Message}");
		}
	}

    private async Task NextPage()
    {
        if (hasNext)
        {
            CurrentPage++;
            await LoadUsersAsync();
        }
    }

    private async Task PrevPage()
    {
        if (hasPrev)
        {
            CurrentPage--;
            await LoadUsersAsync();
        }
    }

    private async Task HandleEnterKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            // Ensure the page number is within valid bounds
            if (CurrentPage < 1)
            {
                CurrentPage = 1;
            }
            else if (CurrentPage > totalPages)
            {
                CurrentPage = totalPages;
            }

            // Load the page with the specified number
            await LoadUsersAsync();
        }
    }
}
