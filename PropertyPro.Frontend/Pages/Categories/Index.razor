@page "/Category"

<h3>Categories</h3>
<a class="btn btn-primary" href="/Category/Create">New Category</a>

@if (categories == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Category</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var category in categories)
            {
                <tr>
                    <td>@category.Id</td>
                    <td>@category.CategoryName</td>
                    <td>
                        <a class="btn btn-danger btn-sm" href="/Category/Delete/@category.Id">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}


@inject ICategotyService CategoryService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

@code {
    private List<Category> categories;
    private string? token;

    protected override async Task OnInitializedAsync()
    {
        // Get the token from localStorage
        token = await GetTokenAsync();

        // If no token found, redirect to login
        if (string.IsNullOrEmpty(token))
        {
            Navigation.NavigateTo("/login");
            return;
        }

        // Fetch Unit Types with token
        await LoadcategoriesAsync();
    }

    private async Task<string?> GetTokenAsync()
    {
        try
        {
            return await JSRuntime.InvokeAsync<string>("localStorage.getItem", "authToken");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error getting token: {ex.Message}");
            return null;
        }
    }

    private async Task LoadcategoriesAsync()
    {
        try
        {

            var response = await CategoryService.GetCategoriesListAsync();

            if (response?.Data != null)
            {
                categories = response.Data;
            }
            else
            {
                Console.WriteLine("Error: No data found in response.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading Unit Types: {ex.Message}");
        }
    }
}
