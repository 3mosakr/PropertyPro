@page "/Category/Delete/{Id:int}"


<h3>Delete</h3>

<h1>Delete Category</h1>
<p>Are you sure you want to delete Category with id @Id</p>
<button class="btn btn-danger" @onclick="DeleteCategory">Delete</button>
<a class="btn btn-secondary" href="/Category">Cancel</a>


@inject ICategotyService CategoryService
@inject NavigationManager navigationManager

@code {
	[Parameter]
	public int Id { get; set; }

	protected async Task DeleteCategory()
	{
		await CategoryService.DeleteCategoryAsync(Id);
		navigationManager.NavigateTo("/Category");
	}
}
