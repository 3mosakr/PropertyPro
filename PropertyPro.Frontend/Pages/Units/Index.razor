@page "/Units"

<h3>Units</h3>
<a class="btn btn-primary" href="/Units/Create">New Unit</a>

@if (units == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Category</th>
                <th>Type</th>
                <th>Sale</th>
                <th>Title</th>
                <th>Unit Area</th>
                <th>No. Of Bedrooms</th>
                <th>No. Of Bathrooms</th>
                <th>Price</th>
                <th>Address</th>
                <th>DatePosted</th>
                <th>User</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var unit in units)
            {
                <tr>
                    <td>@unit.Id</td>
                    <td>@unit.Category</td>
                    <td>@unit.Type</td>
                    <td>@unit.Sale</td>
                    <td>@unit.Title</td>
                    <td>@unit.UnitArea</td>
                    <td>@unit.NumberOfBedrooms</td>
                    <td>@unit.NumberOfBathrooms</td>
                    <td>@unit.Price</td>
                    <td>@unit.Address</td>
                    <td>@unit.DatePosted</td>
                    <td>@unit.User</td>
                    <td>
                        <a class="btn btn-success btn-sm" href="/units/Update/@unit.Id">Edit</a>
                        <a class="btn btn-danger btn-sm" href="/units/Delete/@unit.Id">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div>
        <button class="btn btn-lg btn-primary" @onclick="PrevPage" disabled="@(!hasPrev)">Previous</button>
        <span>
            Page <input type="number" min="1" max="@totalPages" @bind="CurrentPage" @bind:event="oninput" @onkeypress="HandleEnterKey" style="width: 50px;" /> of @totalPages
        </span>
        <button class="btn btn-lg btn-primary" @onclick="NextPage" disabled="@(!hasNext)">Next</button>
    </div>
}


@inject IUnitService UnitService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

@code {
    private List<GetUnitsForListingDto> units = new();
    private string? token;
    private int CurrentPage = 1;
    private int pageSize = 10;
    private bool hasNext;
    private bool hasPrev;
    private int totalPages;

    protected override async Task OnInitializedAsync()
    {
        token = await GetTokenAsync();

        if (string.IsNullOrEmpty(token))
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadUnitsAsync();
    }

    private async Task<string?> GetTokenAsync()
    {
        try
        {
            return await JSRuntime.InvokeAsync<string>("localStorage.getItem", "authToken");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error getting token: {ex.Message}");
            return null;
        }
    }

    private async Task LoadUnitsAsync()
    {
        try
        {
            var response = await UnitService.GetUnitsPaginatedListFilteredAsync(page: CurrentPage, pageSize: pageSize);

            if (response?.Data != null)
            {
                units = response.Data;
                hasNext = response.HasNextPage;
                hasPrev = response.HasPreviousPage;
                totalPages = response.TotalPages;
            }
            else
            {
                units = new List<GetUnitsForListingDto>();
                Console.WriteLine("Error: No data found in response.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading units: {ex.Message}");
        }
    }

    private async Task NextPage()
    {
        if (hasNext)
        {
            CurrentPage++;
            await LoadUnitsAsync();
        }
    }

    private async Task PrevPage()
    {
        if (hasPrev)
        {
            CurrentPage--;
            await LoadUnitsAsync();
        }
    }

    private async Task HandleEnterKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            // Ensure the page number is within valid bounds
            if (CurrentPage < 1)
            {
                CurrentPage = 1;
            }
            else if (CurrentPage > totalPages)
            {
                CurrentPage = totalPages;
            }

            // Load the page with the specified number
            await LoadUnitsAsync();
        }
    }
}
