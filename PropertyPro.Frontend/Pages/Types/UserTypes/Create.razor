@page "/Types/User/Create"

<h3>Create User Type</h3>

<EditForm Model="this" OnValidSubmit="CreateUserType">

	<div class="row">
		<div class="col-lg-8">
			<h1 class="mb-5">New User Type</h1>
			<div class="row mb-3">
				<label class="col-md-4 col-form-label">Type</label>
				<div class="col-md-8">
					<input class="form-control" @bind="Type" required />
				</div>
			</div>

			<div class="row">
				<div class="offset-md-4 col-md-4 d-grid">
					<button class="btn btn-primary" type="submit">Create</button>
				</div>
				<div class="col-md-4 d-grid">
					<a class="btn btn-secondary" href="/Types/User">Back</a>
				</div>
			</div>
		</div>
	</div>
</EditForm>


@inject ITypesService TypesService
@inject NavigationManager navigationManager
@code {
	public string Type { get; set; } = string.Empty;

	private async Task CreateUserType()
	{

		var response = await TypesService.AddUserTypeAsync(Type);
		if (response == null)
		{
			throw new Exception("Failed to create User Type");
		}
		navigationManager.NavigateTo("/Types/User");
	}
}
