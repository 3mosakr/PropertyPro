@page "/Address/City/Create"

<h3>Create City</h3>

<EditForm Model="this" OnValidSubmit="CreateCity">

	<div class="row">
		<div class="col-lg-8">
			<h1 class="mb-5">New City</h1>

			
			<div class="row mb-3">
				<label class="col-md-4 col-form-label">Governorate</label>
				<div class="col-md-8">
					<InputSelect class="form-control" @bind-Value="CityDto.GovernorateId">
						<option selected hidden> -- select Governorate -- </option>
						@foreach (var governorate in Governorates)
						{
							<option value="@governorate.Id">@governorate.GovernorateName</option>
						}
					</InputSelect>
				</div>
			</div>



			<div class="row mb-3">
				<label class="col-md-4 col-form-label">City Name</label>
				<div class="col-md-8">
					<input class="form-control" @bind="CityDto.CityName" required />
				</div>
			</div>

			<div class="row">
				<div class="offset-md-4 col-md-4 d-grid">
					<button class="btn btn-primary" type="submit" >Create</button>
				</div>
				<div class="col-md-4 d-grid">
					<a class="btn btn-secondary" href="/Address/City">Back</a>
				</div>
			</div>
		</div>
	</div>
</EditForm>

@inject IAddressService AddressService
@inject NavigationManager navigationManager
@code {
	public AddCityDto CityDto { get; set; } = new AddCityDto();

	public List<Governorate> Governorates { get; set; } = new List<Governorate>();


	protected async override Task OnInitializedAsync()
	{
		try
		{
			var response = await AddressService.GetGovernorateListAsync();

			if (response?.Data != null)
			{
				Governorates = response.Data;
			}
			else
			{
				Console.WriteLine("Error: No data found in response.");
			}
		}
		catch (Exception ex)
		{
			Console.WriteLine($"Error loading governorates: {ex.Message}");
		}
	
	}

	private async Task CreateCity()
	{
		
		var response = await AddressService.AddCityAsync(CityDto);
		if (response == null)
		{
			throw new Exception("Failed to create City");
		}
		navigationManager.NavigateTo("/Address/City");
	}
}
