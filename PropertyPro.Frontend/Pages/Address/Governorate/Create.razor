@page "/Address/Governorate/Create"

<h3>Create Governorate</h3>

<EditForm Model="this" OnValidSubmit="CreateGovernorate">

	<div class="row">
		<div class="col-lg-8">
			<h1 class="mb-5">New Governorate</h1>
			<div class="row mb-3">
				<label class="col-md-4 col-form-label">Governorate Name</label>
				<div class="col-md-8">
					<input class="form-control" @bind="governorateName" required />
				</div>
			</div>

			<div class="row">
				<div class="offset-md-4 col-md-4 d-grid">
					<button class="btn btn-primary" type="submit" >Create</button>
				</div>
				<div class="col-md-4 d-grid">
					<a class="btn btn-secondary" href="/Address/Governorate">Back</a>
				</div>
			</div>
		</div>
	</div>
</EditForm>

@inject IAddressService AddressService
@inject NavigationManager navigationManager
@code {
	public string governorateName { get; set; } = string.Empty;

	private async Task CreateGovernorate()
	{
		
		var response = await AddressService.AddGovernorateAsync(governorateName);
		if (response == null)
		{
			throw new Exception("Failed to create governorate");
		}
		navigationManager.NavigateTo("/Address/Governorate");
	}
}
